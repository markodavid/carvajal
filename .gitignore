# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv/

# Testing / lint / type caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Environment
.env
.env.*
!.env.example

# Datos del corpus: capas crudas (bronze) y procesadas (silver) se ignoran;
# el entregable versionado es data/gold/ (capa gold).
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Corpus externo: derivados regenerables con `carvajal import`; solo se versiona
# el manifiesto de cada fuente para dejar constancia de qué se importó.
data/external/*/*
!data/external/*/manifest.json

# Índice vectorial FAISS (se regenera desde data/gold/ con `make app` o `carvajal ask`)
data/index/

# Arteefactos
*.log

# IDE
.vscode/
.idea/
